{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stackpost",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  // Workers Logs: requests, erros 5xx/1102 e console.* visiveis no dashboard
  // Cloudflare > Workers > Observability. Sem custo extra no plano pago.
  "observability": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    {
      "pattern": "stackpost.expostacker.com.br",
      "zone_name": "expostacker.com.br",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *",
      "*/5 * * * *",
      "0 * * * *",
      "0 3 * * *",
      "0 0 1 * *"
    ]
  }
}
