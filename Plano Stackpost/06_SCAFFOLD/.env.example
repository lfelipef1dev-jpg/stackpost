# ===========================================
# Stackpost - Variaveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env real.

# --- App ---
NODE_ENV=development
BACKEND_PORT=3001
DASHBOARD_PORT=3000

# --- PostgreSQL ---
POSTGRES_USER=stackpost
POSTGRES_PASSWORD=stackpost_dev
POSTGRES_DB=stackpost
DATABASE_URL=postgresql://stackpost:stackpost_dev@localhost:5432/stackpost

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Cloudflare R2 (Storage) ---
# Criar em: https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stackpost-uploads
R2_PUBLIC_URL=
# Endpoint S3-compativel do R2:
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Auth ---
# Gerar com: openssl rand -hex 32
JWT_SECRET=
# Prefixo das API keys (pk_live_ = producao, pk_test_ = teste)
API_KEY_PREFIX=pk_live_

# --- OAuth: Instagram/Meta (Facebook Login) ---
# https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/oauth/meta/callback

# --- OAuth: TikTok ---
# https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/oauth/tiktok/callback

# --- OAuth: YouTube/Google ---
# https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth/google/callback

# --- OAuth: LinkedIn ---
# https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/oauth/linkedin/callback

# --- OAuth: Twitter/X ---
# https://developer.twitter.com
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3001/oauth/twitter/callback

# --- OAuth: Pinterest ---
# https://developers.pinterest.com
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3001/oauth/pinterest/callback

# --- OAuth: Reddit ---
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3001/oauth/reddit/callback

# --- OAuth: Snapchat ---
# https://kit.snapchat.com
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REDIRECT_URI=http://localhost:3001/oauth/snapchat/callback

# --- OAuth: Bluesky (AT Protocol) ---
# Default PDS: https://bsky.social
BLUESKY_PDS_URL=https://bsky.social

# --- Webhooks ---
# URL base para construir URLs de webhook (seu dashboard)
WEBHOOK_BASE_URL=http://localhost:3001

# --- Sentry (Error Tracking) ---
# https://sentry.io
SENTRY_DSN=

# --- Resend (Email) ---
# https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Stackpost <noreply@expostacker.com.br>

# --- Stripe (Billing) ---
# https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# --- Logging ---
LOG_LEVEL=debug
